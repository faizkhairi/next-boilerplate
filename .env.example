# =============================================================================
# next-boilerplate Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# Do not set NODE_ENV here: Next.js sets it based on the command you run
# (dev/build/start) and ignores a value loaded from .env files.

# =============================================================================
# Database
# =============================================================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/next_boilerplate"

# =============================================================================
# NextAuth.js
# =============================================================================
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-random-string-32-chars"

# =============================================================================
# OAuth Providers (Optional)
# =============================================================================
# Uncomment and fill in to enable GitHub OAuth
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""
# NEXT_PUBLIC_GITHUB_ENABLED="true"

# Uncomment and fill in to enable Google OAuth
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# NEXT_PUBLIC_GOOGLE_ENABLED="true"

# =============================================================================
# Email (SMTP)
# =============================================================================
# Development: caught by Mailpit (docker compose up -d)
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@example.com"

# Production: point at any SMTP provider, for example:
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="app-password"
# SMTP_FROM="your-email@gmail.com"

# =============================================================================
# Stripe (Optional, only if you need payments)
# =============================================================================
# Uncomment and fill in to enable Stripe checkout
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""

# =============================================================================
# Dev server (Optional)
# =============================================================================
# Overrides the port `next dev`/`next start` and Playwright's webServer
# listen on. Defaults to 3000 if unset.
# PORT="3000"
